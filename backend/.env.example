# Copy this file to  backend/.env  and fill the values. (.env is loaded automatically)

# ---- ElevenLabs (voice assistant: text-to-speech + speech-to-text)  -> https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# optional: change the 4 assistant voices (voice ids from your ElevenLabs "Voices" page)
# ELEVENLABS_VOICE_1=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_VOICE_2=pNInz6obpgDQGcFmaJgB
# ELEVENLABS_VOICE_3=EXAVITQu4vr4xnSDxMaL
# ELEVENLABS_VOICE_4=TxGEqnHWrfWFTfGW9XjX
# ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
# ELEVENLABS_STT_MODEL=scribe_v1

# ---- Email for class reminders (Gmail: use a 16-character App Password, not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourcollegealerts@gmail.com
SMTP_PASS=your-16-char-gmail-app-password

# minutes before class start when the reminder goes out (0 = exactly at class time)
CLASS_REMINDER_MINUTES=10

# ---- optional
# DATABASE_PATH=/var/data/campus.db     (keep the DB on a persistent disk when you deploy)
# CORS_ORIGINS=https://your-frontend.example.com
